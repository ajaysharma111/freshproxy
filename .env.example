# Tavily provides live web evidence for freshness checks.
TAVILY_API_KEY=tvly-your-key

# Bifrost gateway URL. For docker-compose, the service name is used automatically.
BIFROST_URL=http://localhost:8080

# Gemini provider key is configured in Bifrost's Model Providers page.
# In Bifrost, set the key value to env.GEMINI_API_KEY.
GEMINI_API_KEY=your-gemini-api-key

# First model is primary; subsequent models are client-side fallbacks.
# Use exact provider/model IDs shown in your Bifrost Model Catalog.
BIFROST_MODELS=gemini/gemini-2.5-flash
# Optional: set this only if your Bifrost gateway requires API-key authentication.
# BIFROST_API_KEY=

PORT=8787
HOST=127.0.0.1
